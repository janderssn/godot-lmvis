; Engine Configuration File.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   key=value ; value can be a string, a number, a boolean or a color

[application]

config/name="Åre Steep"
config/description="A skiing and snowboarding game set in Åre, Sweden using real terrain data from Lantmäteriet"
config/version="0.1.0"
config/tags=PackedStringArray("skiing", "snowboarding", "terrain", "sweden")
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 1)

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/fanotify/code.editor=true

[layer_names]

3d_physics/layer_1="Terrain"
3d_physics/layer_2="Player"
3d_physics/layer_3="Props"
3d_physics/layer_4="Triggers"

[navigation]

baking/threading/number_of_cores_to_use=4

[physics]

3d/default_gravity=9.8
common/max_physics_steps_per_frame=8

[rendering]

textures/vram_compression/import_etc2_astc=true
camera/depth_of_field/depth_of_field_bokeh_shape=2
environment/defaults/default_clear_color=Color(0.529412, 0.807843, 0.921569, 1)
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

